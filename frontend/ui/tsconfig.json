{
  "extends": [
    "@vue/tsconfig/tsconfig.dom.json",
    "@vue/tsconfig/tsconfig.lib.json"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,

    "rootDir": "..",
    "outDir": "./dist/types",

    "baseUrl": "..",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../src/**/*.ts",
    "../src/**/*.d.ts",
    "../src/**/*.vue"
  ],
  "exclude": [
    "dist",
    "../dist",
    "../dist-sdk",
    "../node_modules",
    "node_modules"
  ]
}