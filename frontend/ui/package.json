{
  "name": "@frplm/ui",
  "version": "0.1.0-alpha.1",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/ui/src/index.d.ts",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "vite build --config vite.config.ts",
    "build:types": "vue-tsc -p tsconfig.json",
    "build": "npm run clean && npm run build:js && npm run build:types"
  },
  "exports": {
    ".": {
      "types": "./dist/types/ui/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vue": "^3.5.25",
    "vue-tsc": "^3.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
